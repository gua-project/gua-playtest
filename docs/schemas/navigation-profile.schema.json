{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "actorSelector": {
      "$ref": "https://gua.dev/schema/world-selector.schema.json"
    },
    "actorDomainId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "positionField": {
      "const": "position"
    },
    "spaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "spaceEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "plane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "up": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        },
        "axisX": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        },
        "axisY": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        }
      },
      "required": [
        "up",
        "axisX",
        "axisY"
      ]
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "representation": {
          "enum": [
            "exact",
            "approximation"
          ]
        },
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "footOffset": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        },
        "centerOffset": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        }
      },
      "required": [
        "representation",
        "radius",
        "height",
        "footOffset",
        "centerOffset"
      ]
    },
    "queryPolicyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "consistency": {
      "enum": [
        "bestEffort",
        "samePhysicsSample"
      ]
    },
    "movement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "const": "planarTranslation"
        },
        "actionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "relativeTo": {
          "enum": [
            "world",
            "camera",
            "body"
          ]
        },
        "axisX": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "number",
              "exclusiveMaximum": 0
            },
            "maximum": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "polarity": {
              "enum": [
                -1,
                1
              ]
            }
          },
          "required": [
            "minimum",
            "maximum",
            "polarity"
          ]
        },
        "axisY": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "type": "number",
              "exclusiveMaximum": 0
            },
            "maximum": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "polarity": {
              "enum": [
                -1,
                1
              ]
            }
          },
          "required": [
            "minimum",
            "maximum",
            "polarity"
          ]
        },
        "release": {
          "const": "neutralAtSegmentEnd"
        },
        "basis": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "axisX": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "$ref": "common.schema.json#/$defs/read"
                },
                "y": {
                  "$ref": "common.schema.json#/$defs/read"
                },
                "z": {
                  "$ref": "common.schema.json#/$defs/read"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            },
            "axisY": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "x": {
                  "$ref": "common.schema.json#/$defs/read"
                },
                "y": {
                  "$ref": "common.schema.json#/$defs/read"
                },
                "z": {
                  "$ref": "common.schema.json#/$defs/read"
                }
              },
              "required": [
                "x",
                "y",
                "z"
              ]
            }
          },
          "required": [
            "axisX",
            "axisY"
          ]
        }
      },
      "required": [
        "model",
        "actionId",
        "relativeTo",
        "axisX",
        "axisY",
        "release"
      ]
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxStoppingDistance": {
          "type": "number",
          "minimum": 0
        },
        "maxStoppingMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "velocity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "x": {
              "$ref": "common.schema.json#/$defs/read"
            },
            "y": {
              "$ref": "common.schema.json#/$defs/read"
            },
            "z": {
              "$ref": "common.schema.json#/$defs/read"
            }
          },
          "required": [
            "x",
            "y",
            "z"
          ]
        },
        "grounded": {
          "$ref": "common.schema.json#/$defs/read"
        }
      },
      "required": [
        "maxSpeed",
        "maxStoppingDistance",
        "maxStoppingMilliseconds",
        "velocity",
        "grounded"
      ]
    },
    "arrival": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "speedTolerance": {
          "type": "number",
          "minimum": 0
        },
        "heightTolerance": {
          "type": "number",
          "minimum": 0
        },
        "maxSlopeDegrees": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 90
        }
      },
      "required": [
        "radius",
        "speedTolerance",
        "heightTolerance",
        "maxSlopeDegrees"
      ]
    },
    "survey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        },
        "max": {
          "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
        },
        "minHeight": {
          "type": "number"
        },
        "maxHeight": {
          "type": "number"
        },
        "cellSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "supportSpacing": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "topology": {
          "const": "singleGroundedSurface"
        }
      },
      "required": [
        "min",
        "max",
        "minHeight",
        "maxHeight",
        "cellSize",
        "supportSpacing",
        "topology"
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxObservationAgeMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxInputMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "maxQueries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxNodes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxEdges": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxReplans": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "maxLlmCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "queryDeadlineMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "maxApproachCandidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      },
      "required": [
        "maxObservationAgeMilliseconds",
        "maxInputMilliseconds",
        "maxQueries",
        "maxNodes",
        "maxEdges",
        "maxReplans",
        "maxLlmCalls",
        "queryDeadlineMilliseconds",
        "maxApproachCandidates"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "selector": {
            "$ref": "https://gua.dev/schema/world-selector.schema.json"
          },
          "domainId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "approachPoints": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "uniqueItems": true,
            "items": {
              "$ref": "https://gua.dev/schema/spatial-r1.schema.json#/$defs/vector"
            }
          },
          "approachRadius": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uncollected": {
            "$ref": "common.schema.json#/$defs/read"
          }
        },
        "required": [
          "selector",
          "domainId",
          "approachPoints",
          "approachRadius",
          "uncollected"
        ]
      }
    },
    "preparation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fixtureId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "clock": {
          "enum": [
            "real",
            "game"
          ]
        }
      },
      "required": [
        "fixtureId",
        "clock"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "parameterSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "author",
        "parameterSource"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "actorSelector",
    "actorDomainId",
    "positionField",
    "spaceId",
    "spaceEpoch",
    "plane",
    "capsule",
    "queryPolicyId",
    "consistency",
    "movement",
    "motion",
    "arrival",
    "survey",
    "budgets",
    "targets",
    "preparation",
    "provenance"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua-playtest.dev/schema/navigation-profile.schema.json"
}
