{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua-playtest.dev/schema/planner-decision.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "plannerDecision"
        },
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "decisionRequestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "basedOnObservationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "decision": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "execute"
            },
            "mode": {
              "const": "single"
            },
            "action": {
              "$ref": "common.schema.json#/$defs/action"
            }
          },
          "required": [
            "kind",
            "mode",
            "action"
          ]
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "runId",
        "decisionRequestId",
        "basedOnObservationId",
        "decision"
      ]
    },
