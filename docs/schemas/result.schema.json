{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gua-playtest.dev/schema/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "result"
    },
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "status": {
      "enum": [
        "Passed",
        "Failed",
        "TimedOut",
        "Aborted",
        "Invalid",
        "Unverified"
      ]
    },
    "phase": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "origin": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "reason": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "postProcessing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      },
      "required": [
        "complete",
        "reasons"
      ]
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "kind",
    "schemaVersion",
    "runId",
    "status",
    "phase",
    "origin",
    "reason",
    "postProcessing",
    "finishedAt"
  ]
}
