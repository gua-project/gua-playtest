        {
          "kind": "assertion",
          "read": {
            "target": {
              "source": "ui",
              "selector": {
                "role": {
                  "value": "text"
                },
                "visible": true
              }
            },
            "region": "standard",
            "field": "text",
            "valueType": {
              "type": "string"
            }
          },
